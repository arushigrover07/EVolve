{
  "name": "evolve",
  "networks": {
    "default": {
      "name": "evolve_default"
    }
  },
  "services": {
    "backend1": {
      "build": {
        "context": "C:\\Users\\Arushi Grover\\OneDrive\\EVolve\\backend",
        "dockerfile": "Dockerfile"
      },
      "command": [
        "node",
        "server.js"
      ],
      "env_file": [
        {
          "path": "C:\\Users\\Arushi Grover\\OneDrive\\EVolve\\backend\\.env",
          "required": true
        }
      ],
      "environment": {
        "PG_POOL_MAX": "5",
        "PORT": "5000",
        "TELEMETRY_ENABLED": "false"
      },
      "expose": [
        "5000"
      ],
      "healthcheck": {
        "interval": "15s",
        "retries": 3,
        "start_period": "10s",
        "test": [
          "CMD",
          "node",
          "-e",
          "fetch('http://127.0.0.1:5000/health', { signal: AbortSignal.timeout(2000) }).then(r =\u003e { if (!r.ok) process.exit(1); }).catch(() =\u003e process.exit(1));"
        ],
        "timeout": "3s"
      },
      "networks": {
        "default": null
      },
      "stop_grace_period": "20s"
    },
    "backend2": {
      "build": {
        "context": "C:\\Users\\Arushi Grover\\OneDrive\\EVolve\\backend",
        "dockerfile": "Dockerfile"
      },
      "command": [
        "node",
        "server.js"
      ],
      "env_file": [
        {
          "path": "C:\\Users\\Arushi Grover\\OneDrive\\EVolve\\backend\\.env",
          "required": true
        }
      ],
      "environment": {
        "PG_POOL_MAX": "5",
        "PORT": "5000",
        "TELEMETRY_ENABLED": "false"
      },
      "expose": [
        "5000"
      ],
      "healthcheck": {
        "interval": "15s",
        "retries": 3,
        "start_period": "10s",
        "test": [
          "CMD",
          "node",
          "-e",
          "fetch('http://127.0.0.1:5000/health', { signal: AbortSignal.timeout(2000) }).then(r =\u003e { if (!r.ok) process.exit(1); }).catch(() =\u003e process.exit(1));"
        ],
        "timeout": "3s"
      },
      "networks": {
        "default": null
      },
      "stop_grace_period": "20s"
    },
    "backend3": {
      "build": {
        "context": "C:\\Users\\Arushi Grover\\OneDrive\\EVolve\\backend",
        "dockerfile": "Dockerfile"
      },
      "command": [
        "node",
        "server.js"
      ],
      "env_file": [
        {
          "path": "C:\\Users\\Arushi Grover\\OneDrive\\EVolve\\backend\\.env",
          "required": true
        }
      ],
      "environment": {
        "PG_POOL_MAX": "5",
        "PORT": "5000",
        "TELEMETRY_ENABLED": "false"
      },
      "expose": [
        "5000"
      ],
      "healthcheck": {
        "interval": "15s",
        "retries": 3,
        "start_period": "10s",
        "test": [
          "CMD",
          "node",
          "-e",
          "fetch('http://127.0.0.1:5000/health', { signal: AbortSignal.timeout(2000) }).then(r =\u003e { if (!r.ok) process.exit(1); }).catch(() =\u003e process.exit(1));"
        ],
        "timeout": "3s"
      },
      "networks": {
        "default": null
      },
      "stop_grace_period": "20s"
    },
    "frontend": {
      "build": {
        "args": {
          "VITE_API_URL": "/"
        },
        "context": "C:\\Users\\Arushi Grover\\OneDrive\\EVolve\\frontend",
        "dockerfile": "Dockerfile"
      },
      "depends_on": {
        "backend1": {
          "condition": "service_healthy",
          "required": true
        },
        "backend2": {
          "condition": "service_healthy",
          "required": true
        },
        "backend3": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "5173",
          "target": 80
        }
      ],
      "volumes": [
        {
          "bind": {
            "create_host_path": true
          },
          "read_only": true,
          "source": "C:\\Users\\Arushi Grover\\OneDrive\\EVolve\\frontend\\nginx.compose.conf",
          "target": "/etc/nginx/conf.d/default.conf",
          "type": "bind"
        }
      ]
    },
    "telemetry": {
      "build": {
        "context": "C:\\Users\\Arushi Grover\\OneDrive\\EVolve\\backend",
        "dockerfile": "Dockerfile"
      },
      "command": [
        "node",
        "workers/telemetryWorker.js"
      ],
      "env_file": [
        {
          "path": "C:\\Users\\Arushi Grover\\OneDrive\\EVolve\\backend\\.env",
          "required": true
        }
      ],
      "environment": {
        "PG_POOL_MAX": "5",
        "TELEMETRY_ENABLED": "true"
      },
      "networks": {
        "default": null
      },
      "profiles": [
        "telemetry"
      ],
      "stop_grace_period": "20s"
    }
  },
  "x-api": {
    "build": "./backend",
    "command": [
      "node",
      "server.js"
    ],
    "env_file": [
      "./backend/.env"
    ],
    "environment": {
      "PG_POOL_MAX": "5",
      "PORT": "5000",
      "TELEMETRY_ENABLED": "false"
    },
    "expose": [
      "5000"
    ],
    "healthcheck": {
      "interval": "15s",
      "retries": 3,
      "start_period": "10s",
      "test": [
        "CMD",
        "node",
        "-e",
        "fetch('http://127.0.0.1:5000/health', { signal: AbortSignal.timeout(2000) }).then(r =\u003e { if (!r.ok) process.exit(1); }).catch(() =\u003e process.exit(1));"
      ],
      "timeout": "3s"
    },
    "stop_grace_period": "20s"
  }
}
